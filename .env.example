# This project needs NO secrets, passwords, API keys or tokens. Nothing reads a .env file automatically.
# The code only reads two optional environment variables from the process environment. Set them in PowerShell when
# needed, for example:  $env:ECG_APP_E2E_URL = "http://127.0.0.1:8765"
# The values below are placeholders, not real settings.

# Optional: folder of YOUR OWN copy of PTB-XL v1.0.3 (only for research scripts and the demo's --wfdb mode;
# not needed for the app or the synthetic demo).
PTBXL_ROOT=C:/path/to/your/ptb-xl-1.0.3

# Optional: set only to run the live end-to-end frontend test against a running local backend.
ECG_APP_E2E_URL=http://127.0.0.1:8765
